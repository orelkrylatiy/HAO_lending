# ============================================================
#  HAO Лендинг — пример конфигурации
#  Скопируй этот файл в .env.local и заполни значения
#  $ cp .env.local.example .env.local
# ============================================================

# Здесь только серверные секреты. Контакты сайта (телефон,
# Telegram, WhatsApp) — публичные, живут в коде: app/lib/contacts.ts


# ── Telegram ─────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Получатели уведомлений — можно несколько через запятую
# Как узнать chat_id: напиши боту /start, открой
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
# и найди "chat": { "id": 123... }
TELEGRAM_CHAT_IDS=


# ── Google Sheets ─────────────────────────────────────────────
# URL из Apps Script (Развернуть → Веб-приложение)
# Инструкция: см. SETUP.md
GOOGLE_SCRIPT_URL=


# ── Аварийное сохранение заявок ──────────────────────────────
# Опциональный путь к NDJSON-файлу, куда пишется полный лид,
# если Google Sheets недоступен. Локально по умолчанию:
# .data/failed-leads.ndjson
# На Vercel файловая система временная, поэтому это best-effort fallback,
# а не долговечное хранилище.
FAILED_LEADS_FILE=
